# ============================================
# Jabil Smart Office Backend Dockerfile
# Node.js 22 Alpine
# ============================================

# 阶段1: 构建依赖
FROM node:22-alpine AS deps
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci --only=production

# 阶段2: 生产镜像
FROM node:22-alpine AS production

# 安装时区数据（用于中国时区）
RUN apk add --no-cache tzdata

# 创建应用目录
WORKDIR /app

# 复制依赖
COPY --from=deps /app/node_modules ./node_modules
COPY backend/ ./

# 创建 uploads 目录
RUN mkdir -p uploads logs resources/excel_templates

# 设置时区为上海
ENV TZ=Asia/Shanghai

# 暴露端口
EXPOSE 3002

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3002/api/users/health || exit 1

# 启动命令
CMD ["sh", "-c", "node server.js"]
