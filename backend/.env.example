# ============================================
# Jabil Smart Office - SMTP邮件配置
# ============================================
# 注意：
# 1. 此文件包含敏感信息，不要提交到Git仓库
# 2. 配置后需要重启后端服务器才能生效
# 3. 可以联系IT部门获取正确的SMTP配置信息
# ============================================

# ---------------- 配置选项 ----------------
# 方式1：OAuth2认证（推荐，Office 365必需）
# 不需要密码变更，只需要配置一次
# 需要在Azure AD中注册应用并获取凭证
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_REFRESH_TOKEN=your-refresh-token
# OAUTH_ACCESS_TOKEN=your-access-token (可选，会自动刷新)

# 方式2：基本认证（不推荐，Office 365已禁用）
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@jabil.com
# SMTP_PASS=your-password

# ---------------- Jabil Office 365 配置 ----------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@jabil.com
SMTP_PASS=your-password

# ---------------- OAuth2认证配置说明 ----------------
# 使用OAuth2需要以下步骤：
# 1. 访问 Azure Portal (https://portal.azure.com)
# 2. 注册新应用程序
# 3. 获取 Client ID 和 Client Secret
# 4. 配置 API 权限（SMTP.Send）
# 5. 获取 Refresh Token
#
# 或者使用在线工具获取OAuth2凭证：
# - https://github.com/elevenmore/mailsend-go (可选)
# - https://oauth2.dance/ (可选)
#
# 注意：OAuth2 Refresh Token 会长期有效，不需要频繁更新
