# =====================================================
# SAP GUI 自动化配置
# =====================================================

# ==================== SAP 连接配置 ====================

# SAP 连接名称（SAP Logon 中的连接名称）
SAP_CONNECTION_NAME=DEV

# SAP 客户端编号
SAP_CLIENT=800

# SAP 用户名
SAP_USERNAME=

# SAP 密码
SAP_PASSWORD=

# ==================== 导出配置 ====================

# 导出文件保存路径（确保目录存在且有写入权限）
SAP_EXPORT_PATH=C:/SAP_Exports

# ==================== 超时配置 ====================

# SAP 操作超时时间（毫秒）
SAP_TIMEOUT=120000

# 失败重试次数
SAP_RETRY_COUNT=3

# ==================== 任务配置 ====================

# 是否启用自动登录
SAP_AUTO_LOGIN=true

# 任务之间暂停时间（毫秒）
SAP_TASK_DELAY=3000
